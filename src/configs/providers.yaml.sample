# 智能体提供商配置
# 每个智能体可以独立配置 LLM 提供商
# 请复制此文件为 providers.yaml 并填入你的 API Key

defaults: &defaults
  provider: openai
  model: deepseek-ai/DeepSeek-V4-Flash
  base_url: https://api.siliconflow.cn/v1
  api_key: "your-api-key-here"
  temperature: 0.7
  max_tokens: 409600
  # reasoning_effort: low / medium / high（仅适用于支持推理的模型，如 o1/o3/o4-mini；留空或省略则不传）
  # extra_body:                      # 透传额外请求体，用于非标准参数（如 DeepSeek thinking）
  #   thinking:
  #     type: enabled

outline_writer:
  <<: *defaults

script_writer:
  <<: *defaults

script_converter:
  <<: *defaults

# 可选：用于 `python -m webgal_agent.knowledge.asset_describer`
# 的多模态模型槽位。
# `provider: dashscope` 时会走 DashScope 原生 SDK，可直接传本地图片/视频路径。
asset_describer:
  provider: dashscope
  model: qwen3.6-plus
  base_url: https://dashscope.aliyuncs.com/api/v1
  api_key: "your-dashscope-api-key-here"
  temperature: 0.2
  max_tokens: 4096
  extra_body:
    fps: 2
